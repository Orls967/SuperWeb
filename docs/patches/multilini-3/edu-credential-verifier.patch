From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antigravity Agent <agent@antigravity.google>
Date: Fri, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH] feat(mining,autoserve): integrate CredentialVerifier for K3 blast safety and certified mechanic assignment (Z13)

---
 modules/Mining/Application/Actions/EnforceBlastRadiusSafetyAndGeotechLockAction.php | 16 ++++++++++++++++
 modules/AutoServe/Application/Services/AutoServeFleetMaintenanceBooking.php         | 15 +++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/modules/Mining/Application/Actions/EnforceBlastRadiusSafetyAndGeotechLockAction.php b/modules/Mining/Application/Actions/EnforceBlastRadiusSafetyAndGeotechLockAction.php
index 1111111..2222222 100644
--- a/modules/Mining/Application/Actions/EnforceBlastRadiusSafetyAndGeotechLockAction.php
+++ b/modules/Mining/Application/Actions/EnforceBlastRadiusSafetyAndGeotechLockAction.php
@@ -10,6 +10,8 @@
 use Carbon\CarbonImmutable;
 use InvalidArgumentException;
+use Modules\Edu\Contracts\CredentialVerifier;
+use Modules\Mining\Domain\Exceptions\UncertifiedBlastOfficerException;
 
 final class EnforceBlastRadiusSafetyAndGeotechLockAction
 {
@@ -25,6 +27,15 @@ final class EnforceBlastRadiusSafetyAndGeotechLockAction
     {
+        // Enforce K3 Blasting certification requirement (Z13)
+        $verifier = app(CredentialVerifier::class);
+        if (! $verifier->hasValid($blasterUserId, 'k3_blasting', CarbonImmutable::now())) {
+            throw new UncertifiedBlastOfficerException(
+                "Blaster user [{$blasterUserId}] lacks active k3_blasting credential for blast area [{$pitCode}]."
+            );
+        }
+
         // Validate radius and geotech seismic clearance
diff --git a/modules/AutoServe/Application/Services/AutoServeFleetMaintenanceBooking.php b/modules/AutoServe/Application/Services/AutoServeFleetMaintenanceBooking.php
index 3333333..4444444 100644
--- a/modules/AutoServe/Application/Services/AutoServeFleetMaintenanceBooking.php
+++ b/modules/AutoServe/Application/Services/AutoServeFleetMaintenanceBooking.php
@@ -8,6 +8,8 @@
 use Carbon\CarbonImmutable;
 use InvalidArgumentException;
+use Modules\Edu\Contracts\CredentialVerifier;
 
 final class AutoServeFleetMaintenanceBooking
 {
@@ -35,6 +37,13 @@ final class AutoServeFleetMaintenanceBooking
     {
+        // Enforce EV technician certification for high voltage fleet servicing (Z13)
+        if ($serviceCategory === 'EV_BATTERY_HV') {
+            $verifier = app(CredentialVerifier::class);
+            if (! $verifier->hasValid($mechanicUserId, 'autoserve_ev_tech', CarbonImmutable::now())) {
+                throw new InvalidArgumentException("Mechanic [{$mechanicUserId}] is not certified for EV high voltage maintenance.");
+            }
+        }
+
         // Create booking record
-- 
2.39.5
