From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antigravity Agent <agent@antigravity.google>
Date: Fri, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH] feat(mall): consume egy.meter.read.v1 event for mall common area utility allocation (Z13)

---
 modules/Mall/Application/Listeners/RecordMallElectricityConsumptionListener.php | 38 ++++++++++++++++++++++++++++++++++++++
 modules/Mall/MallServiceProvider.php                                           |  5 +++++
 2 files changed, 43 insertions(+)
 create mode 100644 modules/Mall/Application/Listeners/RecordMallElectricityConsumptionListener.php

diff --git a/modules/Mall/Application/Listeners/RecordMallElectricityConsumptionListener.php b/modules/Mall/Application/Listeners/RecordMallElectricityConsumptionListener.php
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/modules/Mall/Application/Listeners/RecordMallElectricityConsumptionListener.php
@@ -0,0 +1,38 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Modules\Mall\Application\Listeners;
+
+use Illuminate\Support\Facades\Log;
+use Modules\Egy\Events\EgyMeterReadV1;
+
+class RecordMallElectricityConsumptionListener
+{
+    /**
+     * Consume egy.meter.read.v1 event to allocate electricity consumption
+     * to mall common area utilities and tenant sub-billing profiles.
+     */
+    public function handle(EgyMeterReadV1 $event): void
+    {
+        if (! str_starts_with($event->propertyId, 'PROP-MALL-') && ! str_starts_with($event->propertyId, 'MALL-')) {
+            return;
+        }
+
+        Log::info('Mall common area electricity consumption recorded', [
+            'property_id' => $event->propertyId,
+            'meter_id' => $event->meterId,
+            'reading_id' => $event->readingId,
+            'interval_wh' => $event->intervalWh,
+            'reading_at' => $event->readingAt,
+        ]);
+    }
+}
diff --git a/modules/Mall/MallServiceProvider.php b/modules/Mall/MallServiceProvider.php
index 2222222..3333333 100644
--- a/modules/Mall/MallServiceProvider.php
+++ b/modules/Mall/MallServiceProvider.php
@@ -10,6 +10,11 @@
+        \Illuminate\Support\Facades\Event::listen(
+            \Modules\Egy\Events\EgyMeterReadV1::class,
+            \Modules\Mall\Application\Listeners\RecordMallElectricityConsumptionListener::class
+        );
-- 
