+    private function authorizeOutletAccess(?int $outletId, ?User $user): void
+    {
+        if (! $user || ! in_array($user->role, ['outlet_manager', 'kitchen'], true)) {
+            return;
+        }
+
+        $hasAccess = RestoStaffAssignment::where('user_id', $user->id)
+            ->where('outlet_id', $outletId)
+            ->where('is_active', true)
+            ->exists();
+
+        if (! $hasAccess) {
+            abort(403, 'Akses ditolak: Anda tidak ditugaskan pada outlet ini.');
+        }
+    }
